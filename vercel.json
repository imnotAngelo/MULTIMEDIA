{
  "buildCommand": "npm install --prefix app && npm run build --prefix app",
  "devCommand": "npm run dev --prefix app",
  "installCommand": "npm install --prefix app",
  "outputDirectory": "app/dist",
  "env": {
    "VITE_API_URL": "https://multimedia-2-x7ol.onrender.com/api"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://multimedia-2-x7ol.onrender.com/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}