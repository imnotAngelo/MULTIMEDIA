{
  "buildCommand": "npm --prefix app run build",
  "devCommand": "npm --prefix app run dev",
  "installCommand": "npm --prefix app install",
  "outputDirectory": "app/dist",
  "env": {
    "VITE_API_URL": "https://multimedia-2-x7ol.onrender.com/api"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://multimedia-2-x7ol.onrender.com/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}